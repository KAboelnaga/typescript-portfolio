# Copy this file to .env (gitignored) and fill in real values from your
# EmailJS account to make Contact's form actually send. See DONE.md /
# TODO.md for the step-by-step setup. Until all three are set, the form
# falls back to its old mailto: behavior unchanged.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
